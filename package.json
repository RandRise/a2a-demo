{
  "name": "relay-a2a-course-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A visible two-agent handoff using the official A2A SDK.",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5173 --strictPort",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test",
    "test:live": "node scripts/live-check.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:docs": "node scripts/docs-browser-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright-core": "1.64.0",
    "prettier": "3.6.2",
    "vitepress": "1.6.4",
    "vue": "3.5.44"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
